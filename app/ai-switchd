#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""ai-switchd - 飞牛 NAS 大模型切换应用后端
通过 SSH 管理 192.168.50.10 (V100 Duo) 上的 LLM/视频/vLLM 服务模式。
纯标准库实现。
"""
import os, sys, json, time, socket, subprocess, threading, logging
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import urlparse, parse_qs

os.environ["PATH"] = "/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin:/bin:/sbin" + os.pathsep + os.environ.get("PATH", "")

TRIM_PKGVAR  = os.environ.get("TRIM_PKGVAR",  "/var/apps/ai-switch/var")
TRIM_PKGETC  = os.environ.get("TRIM_PKGETC",  "/var/apps/ai-switch/etc")
TRIM_APPDEST = os.environ.get("TRIM_APPDEST", "/var/apps/ai-switch/target")
PORT = int(os.environ.get("TRIM_SERVICE_PORT", "8479"))

for d in (TRIM_PKGVAR, TRIM_PKGETC):
    try: os.makedirs(d, exist_ok=True)
    except Exception: pass

LOG_FILE = os.path.join(TRIM_PKGVAR, "info.log")
logging.basicConfig(level=logging.INFO, format="%(asctime)s %(levelname)s %(message)s",
                    handlers=[logging.FileHandler(LOG_FILE), logging.StreamHandler(sys.stdout)])
LOGGER = logging.getLogger("ai-switch")

CONFIG_PATH = os.path.join(TRIM_PKGETC, "config.json")
DEFAULT_CONFIG = {
    "ssh_host": "192.168.50.10",
    "ssh_user": "guoxizheng",
    "ssh_pass": "",
    "wol_mac": "0c:9d:92:cb:3e:1e",
    "wol_broadcast": "192.168.50.255",
    "poll_interval": 15,
}

def load_config():
    cfg = dict(DEFAULT_CONFIG)
    try:
        with open(CONFIG_PATH) as f: cfg.update(json.load(f))
    except Exception: pass
    return cfg

CONFIG = load_config()
STATUS = {"online": False, "raw": None, "last_check": 0, "switching": None, "error": ""}
LOCK = threading.Lock()
LOG_BUFFER = []

def push_log(msg):
    line = f"[{time.strftime('%H:%M:%S')}] {msg}"
    LOG_BUFFER.append(line)
    if len(LOG_BUFFER) > 300: del LOG_BUFFER[:150]
    LOGGER.info(msg)

def ssh_exec(cmd, timeout=25):
    """SSH 执行远程命令, 返回 (rc, out, err)"""
    env = dict(os.environ)
    env["SSHPASS"] = CONFIG.get("ssh_pass", "")
    full = ["sshpass", "-e", "ssh", "-T",
            "-o", "StrictHostKeyChecking=no",
            "-o", "UserKnownHostsFile=/dev/null",
            "-o", "ConnectTimeout=8",
            "-o", "LogLevel=ERROR",
            f"{CONFIG.get('ssh_user')}@{CONFIG.get('ssh_host')}", cmd]
    try:
        p = subprocess.run(full, capture_output=True, timeout=timeout, env=env)
        return p.returncode, p.stdout.decode("utf-8", "replace").strip(), p.stderr.decode("utf-8", "replace").strip()
    except subprocess.TimeoutExpired:
        return -1, "", "SSH 超时"
    except FileNotFoundError:
        return -1, "", "缺少 sshpass"
    except Exception as e:
        return -1, "", str(e)

def fetch_status():
    rc, out, err = ssh_exec("~/ai-mode.sh --json", timeout=20)
    with LOCK:
        if rc == 0 and out.startswith("{"):
            try:
                data = json.loads(out)
                STATUS.update(online=True, raw=data, last_check=time.time(), error="")
                if STATUS.get("switching") == data.get("mode"):
                    STATUS["switching"] = None
                return data
            except Exception as e:
                STATUS.update(online=False, error=f"解析失败: {e}")
        else:
            STATUS.update(online=False, error=err or f"SSH 返回 {rc}")
        STATUS["last_check"] = time.time()
    return None

def poller():
    while True:
        try: fetch_status()
        except Exception as e: LOGGER.warning("poll: %s", e)
        time.sleep(max(int(CONFIG.get("poll_interval", 15)), 5))

def send_wol():
    mac_hex = CONFIG.get("wol_mac", "").replace(":", "").replace("-", "")
    bcast = CONFIG.get("wol_broadcast", "192.168.50.255")
    try:
        mac = bytes.fromhex(mac_hex)
    except Exception:
        return False, "MAC 地址格式错误"
    pkt = b"\xff" * 6 + mac * 16
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
        for dst in (bcast, CONFIG.get("ssh_host", "")):
            for port in (7, 9):
                for _ in range(3):
                    s.sendto(pkt, (dst, port)); time.sleep(0.02)
        s.close()
        return True, f"已发送 WOL 魔法包到 {mac_hex}"
    except Exception as e:
        return False, f"WOL 发送失败: {e}"

MODES = {
    "llm":   {"title": "LLM 对话", "desc": "NInfer · Qwen3.8-27B · :8080", "gpu": "双卡 (~13.4GB/卡)"},
    "video": {"title": "视频生成", "desc": "ComfyUI · Wan2.2 5B · :8188", "gpu": "双卡 (按需)"},
    "vllm":  {"title": "vLLM 推理", "desc": "vLLM · Qwen3-30B-A3B · :8000", "gpu": "双卡"},
    "off":   {"title": "全部关停", "desc": "释放显存, 恢复自动休眠", "gpu": "释放"},
}

# ---------- HTTP ----------
class Handler(BaseHTTPRequestHandler):
    def log_message(self, *a): pass

    def _json(self, obj, code=200):
        data = json.dumps(obj, ensure_ascii=False).encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers(); self.wfile.write(data)

    def _file(self, path, ctype):
        try:
            with open(path, "rb") as f: data = f.read()
            self.send_response(200)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(data)))
            self.end_headers(); self.wfile.write(data)
        except Exception:
            self.send_error(404)

    def do_GET(self):
        u = urlparse(self.path)
        q = parse_qs(u.query)
        if u.path == "/api/status":
            with LOCK:
                st = dict(STATUS)
            self._json({
                "online": st.get("online", False),
                "error": st.get("error", ""),
                "switching": st.get("switching"),
                "last_check": st.get("last_check", 0),
                "modes": MODES,
                "host": CONFIG.get("ssh_host"),
                "data": st.get("raw"),
            })
        elif u.path == "/api/config":
            self._json({k: (v if k != "ssh_pass" else ("***" if v else "")) for k, v in CONFIG.items()})
        elif u.path == "/api/log":
            self._json({"log": LOG_BUFFER[-80:][::-1]})
        elif u.path == "/" or u.path == "/index.html":
            self._file(os.path.join(TRIM_APPDEST, "ui", "index.html"), "text/html; charset=utf-8")
        elif u.path.startswith("/images/"):
            self._file(os.path.join(TRIM_APPDEST, "ui", u.path.lstrip("/")), "image/png")
        else:
            self.send_error(404)

    def do_POST(self):
        u = urlparse(self.path)
        length = int(self.headers.get("Content-Length") or 0)
        try: body = json.loads(self.rfile.read(length) or b"{}")
        except Exception: body = {}
        if u.path == "/api/switch":
            mode = body.get("mode")
            if mode not in MODES:
                self._json({"error": "未知模式"}); return
            if not CONFIG.get("ssh_pass"):
                self._json({"error": "未配置 SSH 密码"}); return
            with LOCK: STATUS["switching"] = mode
            rc, out, err = ssh_exec(f"~/ai-mode.sh {mode}", timeout=60)
            if rc == 0:
                push_log(f"切换到 {MODES[mode]['title']}: {out.splitlines()[-1] if out else 'ok'}")
                data = fetch_status()
                self._json({"ok": True, "message": out, "data": data})
            else:
                with LOCK: STATUS["switching"] = None
                push_log(f"切换失败({mode}): {err or out}")
                self._json({"ok": False, "error": err or out or f"SSH 返回 {rc}"})
        elif u.path == "/api/wol":
            ok, msg = send_wol()
            push_log(f"WOL: {msg}")
            self._json({"ok": ok, "message": msg})
        else:
            self.send_error(404)

if __name__ == "__main__":
    push_log(f"ai-switchd 启动, 端口 {PORT}, 目标 {CONFIG.get('ssh_user')}@{CONFIG.get('ssh_host')}")
    threading.Thread(target=poller, daemon=True).start()
    server = ThreadingHTTPServer(("0.0.0.0", PORT), Handler)
    server.serve_forever()
